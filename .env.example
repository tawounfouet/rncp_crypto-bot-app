# Crypto-Bot Environment Variables
# ==================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PWD=your_postgres_password

# MongoDB
MONGODB_USER=admin
MONGODB_PWD=your_mongo_password
MONGODB_USER_ADMIN=admin
MONGODB_PWD_ADMIN=your_mongo_admin_password

# MinIO
MINIO_USER_ADMIN=minioadmin
MINIO_PWD_ADMIN=your_minio_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password

# Binance API (optionnel)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Cle AES pour le chiffrement des credentials Binance en BDD
# Generer avec : python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
BINANCE_ENC_KEY=

# Version applicative (injectee automatiquement par la CI)
# APP_VERSION=dev
