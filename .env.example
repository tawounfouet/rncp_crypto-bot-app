# Crypto-Bot Environment Variables
# ==================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PWD=your_postgres_password

# MinIO
MINIO_USER_ADMIN=minioadmin
MINIO_PWD_ADMIN=your_minio_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password


# Cle AES pour le chiffrement des credentials Binance en BDD
# Generer avec : python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
EXCHANGE_ENC_KEY=

# Cle de signature des JWT (sessions utilisateur) - distincte de EXCHANGE_ENC_KEY.
# Obligatoire (pas de valeur par defaut cote code : falsifiable si publique/hardcodee).
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# Origines autorisees a appeler l'API depuis un navigateur (liste separee par des
# virgules). Obligatoire, pas de "*" : doit lister precisement l'URL du frontend.
CORS_ORIGINS=http://localhost:8501

# Hosts autorises dans l'en-tete HTTP Host (TrustedHostMiddleware), liste separee par
# des virgules. Obligatoire, pas de "*" : sinon aucune protection contre l'injection
# d'en-tete Host. "crypto-bot-backend" = nom du service docker-compose, requis pour les
# appels serveur-a-serveur du frontend vers le backend (meme valeur sur les 3 environnements,
# ne depend pas de qui/d'ou on accede a l'app : Host verifie l'adresse visee, pas l'IP source).
ALLOWED_HOSTS=localhost,127.0.0.1,crypto-bot-backend

# Version applicative (injectee automatiquement par la CI)
# APP_VERSION=dev

# Airflow
AIRFLOW_FERNET_KEY=  # Generer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_WEBSERVER_SECRET_KEY=  # Chaine aleatoire pour la session webserver
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
