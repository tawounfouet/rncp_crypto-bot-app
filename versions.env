# --- Images Docker (docker-compose) ---
# Source unique de verite pour toutes les versions d'images
# Pour mettre a jour : docker pull <image> && docker inspect --format='{{index .RepoDigests 0}}' <image>

POSTGRES_IMAGE=postgres:14
ADMINER_IMAGE=adminer
MINIO_IMAGE=minio/minio
MINIO_MC_IMAGE=minio/mc
AIRFLOW_IMAGE=apache/airflow:2.8.1-python3.11
REDIS_IMAGE=redis:7-alpine

# Version Airflow a re-epingler dans requirements (sinon les providers font
# monter apache-airflow en 3.x -> binaire introuvable). DOIT rester alignee
# avec le tag d'AIRFLOW_IMAGE ci-dessus.
AIRFLOW_VERSION=2.8.1

# --- Images CI (epinglees, pas de latest !) ---
# 3.11 (pas 3.14) : mlflow n'est pas encore compatible avec Python 3.14
# (ImportError sur importlib.abc.Traversable, cf. models/mlflow-ui).
PYTHON_VERSION=3.11.15
PYTHON_CI_IMAGE=python:3.11.15-slim
SEMGREP_IMAGE=semgrep/semgrep:1.170.0
# Semgrep via pre-commit (.pre-commit-config.yaml) s'installe depuis un tag git
# du depot semgrep/semgrep (pip), pas depuis l'image Docker ci-dessus : cadence
# de release differente, donc version distincte mais a garder proche. Verifiee
# par check-infra.sh (pas fonctionnelle : pre-commit ne lit pas ce fichier).
SEMGREP_PRECOMMIT_VERSION=1.165.0
HADOLINT_IMAGE=hadolint/hadolint:v2.12.0-debian
RELEASE_CLI_IMAGE=registry.gitlab.com/gitlab-org/release-cli:v0.18.0

# --- Versions des Packages Python Clés ---
# fastapi/uvicorn/pydantic/pydantic-settings/numpy/pyarrow/requests/scikit-learn
# alignes le 2026-07-31 sur les versions deja resolues et tournant dans models/
# (etaient plus recentes que les pins historiques de backend). Necessite un
# rebuild+test de backend apres ce changement (versions jamais testees dessus).
FASTAPI_VERSION=0.139.2
UVICORN_VERSION=0.51.0
PYDANTIC_VERSION=2.13.4
PYDANTIC_SETTINGS_VERSION=2.14.2
PYJWT_VERSION=2.12.1
ARGON2_CFFI_VERSION=25.1.0
PYTHON_MULTIPART_VERSION=0.0.27
SQLALCHEMY_VERSION=2.0.48
# Les jobs s'exécutent DANS l'image Airflow (PythonOperator) et partagent son venv.
# Airflow 2.8.1 exige sqlalchemy<2.0 -> les jobs doivent utiliser cette contrainte
# (leur code n'utilise que l'API Core, compatible 1.4). Le backend, lui, reste en 2.x.
AIRFLOW_SQLALCHEMY_SPEC=>=1.4.28,<2.0
PSYCOPG2_VERSION=2.9.12
MINIO_VERSION=7.2.20
PANDAS_VERSION=2.3.3
NUMPY_VERSION=2.4.6
PYARROW_VERSION=24.0.0
FASTPARQUET_VERSION=2026.3.0
PYYAML_VERSION=6.0.3
TORCH_VERSION=2.13.0+cpu
MATPLOTLIB_VERSION=3.11.1
STREAMLIT_VERSION=1.60.0
PLOTLY_VERSION=5.24.1
BINANCE_VERSION=1.0.35
# Multi-exchange (ccxt) - client unifié Binance/Kraken/futurs
CCXT_VERSION=4.5.63
# Machine Learning - pins PARTAGES backend (inference) + models (entrainement) :
# single source of truth = versions.env (pas models/requirements.txt ni pyproject).
# Backend charge les modeles (joblib/pickle) entraines par models : ces deux
# versions doivent rester identiques, sinon mismatch train<->inference
# (InconsistentVersionWarning sklearn). Bump => tester ensemble backend + models.
SCIKIT_LEARN_VERSION=1.9.0
JOBLIB_VERSION=1.5.3
XGBOOST_VERSION=3.4.0
# Epinglee (pas de >=) : la 3.14.0 introduit le job runner (huey), qui gonfle
# la RAM de mlflow-ui si non desactive (cf. MLFLOW_SERVER_ENABLE_JOB_EXECUTION
# dans docker-compose). Un bump de version doit etre teste manuellement avant.
MLFLOW_VERSION=3.14.0
PYTHON_DOTENV_VERSION=1.2.2
REQUESTS_VERSION=2.34.2
