# --- Images Docker (docker-compose) ---
# Source unique de verite pour toutes les versions d'images
# Pour mettre a jour : docker pull <image> && docker inspect --format='{{index .RepoDigests 0}}' <image>

MONGO_IMAGE=mongo:4.4
MONGO_EXPRESS_IMAGE=mongo-express
POSTGRES_IMAGE=postgres:14
ADMINER_IMAGE=adminer
MINIO_IMAGE=minio/minio
MINIO_MC_IMAGE=minio/mc

# --- Images CI (epinglees, pas de latest !) ---
PYTHON_VERSION=3.14.3
PYTHON_CI_IMAGE=python:3.14.3-slim
SEMGREP_IMAGE=semgrep/semgrep:1.121.0
HADOLINT_IMAGE=hadolint/hadolint:v2.12.0-debian
RELEASE_CLI_IMAGE=registry.gitlab.com/gitlab-org/release-cli:v0.18.0
